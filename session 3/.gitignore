# =============================================================================
# LARGE DATA FILES — do not commit to GitHub
# Download instructions: see DATA_SOURCES.md
# =============================================================================

# Urban Atlas land use (>100MB)
*.fgb
*.gpkg
*.shp
*.shx
*.dbf
*.prj

# Raw air quality CSVs
data/raw/*.csv

# Processed/output CSVs (generated by scripts — don't need versioning)
data/processed/*.csv
data/output/*.csv

# Python virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Jupyter checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Reports (generated automatically)
reports/*.txt